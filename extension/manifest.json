{
  "manifest_version": 3,
  "name": "SmartCapture",
  "version": "0.4.0",
  "description": "Automatically collect popup states and export one context-linked PNG",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SmartCapture",
    "default_popup": "popup.html"
  }
}