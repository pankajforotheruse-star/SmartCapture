{
  "manifest_version": 3,
  "name": "SmartCapture",
  "version": "0.1.0",
  "description": "Capture successive popup states with anchored connectors in one PNG",
  "permissions": [
    "activeTab",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SmartCapture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-popup": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the currently visible popup"
    }
  }
}